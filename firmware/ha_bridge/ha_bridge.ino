/*
 * ha_bridge.ino  --  433 MHz remote -> Home Assistant, on an ESP32-S3
 *
 * Listens to the receiver, decodes frames with the rc-switch library (same
 * protocol table the capture UI uses), matches them against the button table
 * in config.h (generated by the rc-capture server from your library and your
 * Home Assistant settings) and calls the mapped Home Assistant service over
 * WiFi using the REST API.
 *
 * Wiring: receiver VCC -> 3V3, GND -> GND, DAT -> GPIO RX_PIN (config.h), antenna 17.3 cm.
 *
 * Serial (115200, native USB) prints one line per event so the capture UI's
 * Serial log can follow along:
 *   I ha_bridge <version> buttons=<n> wifi=<ssid>
 *   W <wifi status / ip>
 *   R <protocol> <bits> <code hex>            every decoded frame
 *   M <button> -> <service> (<http status>)   a matched press that was sent to HA
 *   D <button> still held, new counter ignored   the button is being held; one action per press
 *   E <message>
 *
 * Build: ESP32S3 Dev Module, "USB CDC On Boot: Enabled". Library: rc-switch.
 */

#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include <RCSwitch.h>
#include "config.h"

#define FW_VERSION "1.0.0"

#ifndef RX_PIN
#define RX_PIN 4
#endif
#ifndef PRESS_GAP_MS
#define PRESS_GAP_MS 500     // frames of the same button closer than this belong to one press,
                             // even if the remote's counter byte changed mid-hold
#endif

static RCSwitch rx;
static unsigned long lastWifiTry = 0;

static const size_t N_BUTTONS = sizeof(BUTTONS) / sizeof(BUTTONS[0]);
static unsigned long lastSeen[sizeof(BUTTONS) / sizeof(BUTTONS[0]) + 1];  // last frame of each button
static uint32_t lastCodeByButton[sizeof(BUTTONS) / sizeof(BUTTONS[0]) + 1];

static void connectWifi() {
  if (WiFi.status() == WL_CONNECTED) return;
  if (millis() - lastWifiTry < 5000 && lastWifiTry != 0) return;
  lastWifiTry = millis();
  Serial.print(F("W connecting to "));
  Serial.println(WIFI_SSID);
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
}

// Persistent clients so the TCP/TLS connection is reused between presses:
// the first HTTPS call costs ~800 ms for the handshake, later ones far less.
static WiFiClientSecure secureClient;
static WiFiClient plainClient;
static HTTPClient http;

static int callHomeAssistant(const char *path, const char *body) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println(F("E wifi not connected, action dropped"));
    return -1;
  }
  String url = String(HA_URL) + path;
  bool tls = url.startsWith("https://");
  static bool tlsConfigured = false;
  if (tls && !tlsConfigured) { secureClient.setInsecure(); tlsConfigured = true; }
  http.setReuse(true);
  if (!http.begin(tls ? (WiFiClient &)secureClient : plainClient, url)) {
    Serial.println(F("E http.begin failed"));
    return -2;
  }
  http.setTimeout(5000);
  http.addHeader("Authorization", String("Bearer ") + HA_TOKEN);
  http.addHeader("Content-Type", "application/json");
  int status = http.POST((uint8_t *)body, strlen(body));
  if (status < 0) {
    Serial.print(F("E http error: "));
    Serial.println(http.errorToString(status));
  } else if (status >= 300) {
    Serial.print(F("E HA replied "));
    Serial.print(status);
    Serial.print(' ');
    Serial.println(http.getString().substring(0, 160));
  }
  http.end();
  return status;
}

static void handleCode(uint8_t protocol, uint8_t bits, uint32_t code) {
  Serial.print(F("R "));
  Serial.print(protocol);
  Serial.print(' ');
  Serial.print(bits);
  Serial.print(F(" 0x"));
  Serial.println(code, HEX);

  unsigned long now = millis();
  int hit = -1;
  int hitBits = -1;
  for (size_t i = 0; i < N_BUTTONS; i++) {
    const ButtonMap &b = BUTTONS[i];
    if (b.protocol != protocol || b.bits != bits) continue;
    if ((code & b.mask) != (b.code & b.mask)) continue;
    int nb = __builtin_popcount(b.mask);
    if (nb > hitBits) { hit = (int)i; hitBits = nb; }
  }
  if (hit < 0) return;

  const ButtonMap &b = BUTTONS[hit];
  // One action per physical press: while frames of this button keep arriving
  // with gaps shorter than PRESS_GAP_MS the button is still held, whatever the
  // counter byte does. Only silence longer than that counts as a release.
  bool stillHeld = lastSeen[hit] != 0 && (now - lastSeen[hit]) < PRESS_GAP_MS;
  lastSeen[hit] = now;
  if (stillHeld) {
    if (code != lastCodeByButton[hit]) {
      lastCodeByButton[hit] = code;
      Serial.print(F("D "));
      Serial.print(b.name);
      Serial.println(F(" still held, new counter ignored"));
    }
    return;
  }
  lastCodeByButton[hit] = code;
  if (!b.path || !b.path[0]) {
    Serial.print(F("M "));
    Serial.print(b.name);
    Serial.println(F(" -> (no action mapped)"));
    return;
  }
  unsigned long t0 = millis();
  int status = callHomeAssistant(b.path, b.body);
  // Frames that arrived while we were waiting for Home Assistant are repeats
  // of this same press: drop them and restart the release timer from now.
  rx.resetAvailable();
  lastSeen[hit] = millis();
  Serial.print(F("M "));
  Serial.print(b.name);
  Serial.print(F(" -> "));
  Serial.print(b.path);
  Serial.print(F(" ("));
  Serial.print(status);
  Serial.print(F(", "));
  Serial.print(millis() - t0);
  Serial.println(F(" ms)"));
}

void setup() {
  Serial.begin(115200);
#if ARDUINO_USB_MODE
  Serial.setTxTimeoutMs(0);
#endif
  delay(300);
  Serial.print(F("I ha_bridge "));
  Serial.print(F(FW_VERSION));
  Serial.print(F(" buttons="));
  Serial.print(N_BUTTONS);
  Serial.print(F(" wifi="));
  Serial.print(WIFI_SSID);
  Serial.print(F(" rx_pin="));
  Serial.println(RX_PIN);
  rx.enableReceive(digitalPinToInterrupt(RX_PIN));
  connectWifi();
}

void loop() {
  static bool wasConnected = false;
  bool connected = WiFi.status() == WL_CONNECTED;
  if (connected && !wasConnected) {
    Serial.print(F("W connected, ip "));
    Serial.println(WiFi.localIP());
  } else if (!connected && wasConnected) {
    Serial.println(F("W disconnected"));
  }
  wasConnected = connected;
  if (!connected) connectWifi();

  if (rx.available()) {
    uint32_t code = (uint32_t)rx.getReceivedValue();
    uint8_t bits = (uint8_t)rx.getReceivedBitlength();
    uint8_t protocol = (uint8_t)rx.getReceivedProtocol();
    rx.resetAvailable();
    if (code != 0) handleCode(protocol, bits, code);
  }

  // one-line commands from the UI: "?" identify, "T <index>" fire a button's action
  static char buf[16];
  static uint8_t len = 0;
  while (Serial.available()) {
    char c = (char)Serial.read();
    if (c == '\n' || c == '\r') {
      buf[len] = 0;
      if (len) {
        if (buf[0] == '?') {
          Serial.print(F("I ha_bridge "));
          Serial.print(F(FW_VERSION));
          Serial.print(F(" buttons="));
          Serial.print(N_BUTTONS);
          Serial.print(F(" wifi="));
          Serial.print(WiFi.status() == WL_CONNECTED ? WiFi.localIP().toString() : String("down"));
          Serial.println();
        } else if (buf[0] == 'T') {
          int i = atoi(buf + 1);
          if (i >= 0 && (size_t)i < N_BUTTONS) {
            int st = callHomeAssistant(BUTTONS[i].path, BUTTONS[i].body);
            Serial.print(F("M test "));
            Serial.print(BUTTONS[i].name);
            Serial.print(F(" ("));
            Serial.print(st);
            Serial.println(')');
          }
        }
      }
      len = 0;
    } else if (len < sizeof(buf) - 1) {
      buf[len++] = c;
    }
  }
}
